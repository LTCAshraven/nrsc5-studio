# Rust build output ----------------------------------------------------
/target/
**/*.rs.bk

# Cargo lock — keep for binaries, but ignore lock backups
**/Cargo.lock.bak

# Bundled / vendored toolchains and SDKs that shouldn't live in git -----
# (multi-gigabyte llvm-mingw + Python bundle; bootstrap script downloads them)
/.toolchains/

# Packaging output ------------------------------------------------------
/dist/

# Out-of-tree build trees for vendored native deps (e.g. the
# SoapySDRPlay3 git clone + CMake build used by
# scripts/build-soapysdrplay3-msys2.ps1). The resulting
# `libsdrPlaySupport.dll` lives in `bin/SoapySDR/modules0.8/` and is
# committed there; the source/build tree itself is reproducible from
# the script and shouldn't bloat the repo.
/build/
bin.backup-*/

# Linux HD Radio decoder, built fresh on the host by
# scripts/build-nrsc5-linux.sh (USE_STATIC, ~MBs). Staged here for the
# cargo link step and .deb/.rpm bundling; reproducible from the script,
# so not committed. (The Windows libnrsc5.dll *is* committed.)
/bin/libnrsc5.so
/bin/libnrsc5.so.bak-*

# Editor & IDE ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
NRSC5-RUST.code-workspace
# OS detritus -----------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store

# Runtime artifacts -----------------------------------------------------
*.log
nrsc5-*.log

# Local config overrides ------------------------------------------------
.env
.env.local
# Personal planning notes (kept local, not in the public repo) ----------
*.private.md

# Scratch output of the Ctrl+Shift+D dock-layout capture helper. The
# curated copy lives at res/default-layout.ron (baked into the binary via
# include_str!); this root-level dump is a throwaway working file.
/dock-layout-dump.ron

# Dev-only one-shot screenshot helper (mocks the album-art cache) -------
scripts/seed-collage-mock.ps1

# Local-only PNG basemap optimization tooling (kept on the dev box, not
# shipped — used to regenerate / shrink the map basemaps by hand).
scripts/png_lossless_opt.sh
scripts/pngquant_sweep.sh
scripts/png_reencode_test.py

# High-resolution 2x map basemap. Distributed as a separate GitHub
# Release asset rather than committed (~57 MB would bloat every clone
# forever). Users drop it into res/ next to the exe; the app prefers it
# over the standard, committed res/map.png when present.
res/map2x.png

# Scratch / working directory for regenerating the map basemaps locally.
res/_newmaps/