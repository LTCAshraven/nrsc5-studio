#!/usr/bin/make -f
# Debian rules file for nrsc5-studio.
#
# Drives debhelper through a `cargo build --release` so the final
# binary in target/release/ ends up under /usr/bin/ in the installed
# package. The `[package.metadata.deb]` block in Cargo.toml is the
# source of truth for cargo-deb builds; this rules file mirrors the
# same install layout for the traditional `debuild` path.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export CARGO_HOME = $(CURDIR)/debian/cargo-home

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_test:
	# Tests are run manually in CI; skip during Debian build to keep
	# build-deps minimal (no nrsc5 helper, no SDR hardware available).

override_dh_auto_install:
	install -D -m 0755 target/release/nrsc5-studio \
		debian/nrsc5-studio/usr/bin/nrsc5-studio
	install -D -m 0644 packaging/linux/nrsc5-studio.desktop \
		debian/nrsc5-studio/usr/share/applications/nrsc5-studio.desktop
	install -D -m 0644 packaging/linux/io.github.ltcashraven.Nrsc5Studio.metainfo.xml \
		debian/nrsc5-studio/usr/share/metainfo/io.github.ltcashraven.Nrsc5Studio.metainfo.xml
	for size in 16 32 48 64 128 256; do \
		install -D -m 0644 \
			packaging/linux/icons/hicolor/$${size}x$${size}/apps/nrsc5-studio.png \
			debian/nrsc5-studio/usr/share/icons/hicolor/$${size}x$${size}/apps/nrsc5-studio.png ; \
	done
	install -D -m 0755 scripts/install-nrsc5-helper.sh \
		debian/nrsc5-studio/usr/share/nrsc5-studio/install-nrsc5-helper.sh

override_dh_auto_clean:
	cargo clean || true
	rm -rf debian/cargo-home

override_dh_installman:
	dh_installman packaging/linux/nrsc5-studio.1

override_dh_strip:
	# `strip = true` is already set in the [profile.release] block;
	# skip dh_strip so it doesn't try (and fail loudly) to strip an
	# already-stripped binary.
	@true
